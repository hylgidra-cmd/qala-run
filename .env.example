POSTGRES_DB=dontstop
POSTGRES_USER=dontstop
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://dontstop:change_me@db:5432/dontstop
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace_with_at_least_32_random_bytes
# Leave empty to keep the admin routes closed.
ADMIN_KEY=
# Comma-separated Google OAuth client ids whose ID tokens are accepted.
GOOGLE_CLIENT_IDS=
ENV=development
CORS_ORIGINS=http://localhost:5173,https://localhost
VITE_API_URL=/api/v1
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# The same Google OAuth web client id as in GOOGLE_CLIENT_IDS; unset = Google sign-in hidden.
VITE_GOOGLE_CLIENT_ID=
